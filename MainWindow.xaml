<Window x:Class="MyMCLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyMCLauncher"
        mc:Ignorable="d"
        Title="MyMCLauncher"
        Height="700"
        Width="1100"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="220" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Border BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="24">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="MyMCLauncher"
                               FontSize="28"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="内容区占位：版本列表 / 启动按钮"
                               Margin="0,8,0,0"
                               Foreground="#666666"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <StackPanel HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Margin="12,12,0,0">
                <TextBlock Text="账号"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                <Grid>
                    <ComboBox x:Name="AccountComboBox"
                              Width="220"
                              DisplayMemberPath="DisplayName"
                              VerticalContentAlignment="Center"
                              SelectionChanged="AccountComboBox_SelectionChanged" />
                    <TextBlock x:Name="NoAccountText"
                               Text="未登录"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#888888"
                               IsHitTestVisible="False"
                               Visibility="Collapsed" />
                </Grid>

                <Button x:Name="AddAccountButton"
                        Content="添加账号"
                        Margin="8,0,0,0"
                        Padding="12,4"
                        Click="AddAccount_Click" />
                <Button x:Name="RemoveAccountButton"
                        Content="删除"
                        Margin="8,0,0,0"
                        Padding="12,4"
                        Click="RemoveAccount_Click" />
            </StackPanel>

            <Button Content="设置"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,12,12,0"
                    Padding="16,4"
                    Click="OpenSettings_Click" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="日志"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="清空"
                            Padding="10,2"
                            Margin="0,0,6,0"
                            Click="ClearLog_Click" />
                    <Button Content="复制"
                            Padding="10,2"
                            Margin="0,0,6,0"
                            Click="CopyLog_Click" />
                    <Button Content="打开日志目录"
                            Padding="10,2"
                            Click="OpenLogFolder_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">
                <ListBox x:Name="LogList"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <StatusBar Grid.Row="2" Margin="0,12,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText"
                           Text="就绪"
                           TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
