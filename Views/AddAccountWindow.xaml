<Window x:Class="MyMCLauncher.Views.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="添加账号"
        Height="400"
        Width="480"
        MinHeight="380"
        MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="离线登录" Padding="10">
            <StackPanel>
                <TextBlock Text="用户名" />
                <TextBox x:Name="UsernameBox"
                         Margin="0,4,0,0"
                         Padding="4,2"
                         VerticalContentAlignment="Center"
                         TextChanged="UsernameBox_TextChanged" />
                <TextBlock x:Name="HintText"
                           Margin="0,6,0,0"
                           Foreground="#666666"
                           TextWrapping="Wrap"
                           Text="1–16 个字符；中文用户名在部分服务器可能不可用。" />
                <Button x:Name="AddOfflineButton"
                        Content="添加离线账号"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,0"
                        Padding="16,4"
                        IsDefault="True"
                        Click="AddOffline_Click" />
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="微软正版" Margin="0,12,0,0" Padding="10">
            <StackPanel>
                <Button Content="微软登录（P6 开放）"
                        IsEnabled="False"
                        HorizontalAlignment="Left"
                        Padding="16,4" />
                <TextBlock Text="将在 P6 阶段接入系统浏览器登录。"
                           Margin="0,6,0,0"
                           Foreground="#888888" />
            </StackPanel>
        </GroupBox>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="2"
                   Margin="0,10,0,0"
                   Foreground="#CC0000"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="取消"
                    Padding="20,4"
                    IsCancel="True"
                    Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
