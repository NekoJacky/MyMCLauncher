<Window x:Class="MyMCLauncher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="设置"
        Height="600"
        Width="720"
        MinHeight="560"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="游戏目录" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="GameDirectoryBox"
                             VerticalContentAlignment="Center"
                             Padding="4,2"
                             TextChanged="GameDirectoryBox_TextChanged"
                             LostFocus="GameDirectoryBox_LostFocus" />

                    <Button Grid.Column="1"
                            Content="浏览..."
                            Margin="8,0,0,0"
                            Padding="12,2"
                            Click="BrowseGameDirectory_Click" />
                </Grid>

                <TextBlock x:Name="GameDirectoryStatusText"
                           Grid.Row="1"
                           Margin="0,6,0,0"
                           Foreground="#666666"
                           TextWrapping="Wrap" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Java 运行时" Margin="0,12,0,0" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ComboBox x:Name="JavaComboBox"
                          DisplayMemberPath="DisplayName"
                          VerticalContentAlignment="Center"
                          Padding="4,2"
                          SelectionChanged="JavaComboBox_SelectionChanged" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="RescanJavaButton"
                            Content="重新扫描"
                            Padding="12,2"
                            Margin="0,0,8,0"
                            Click="RescanJava_Click" />
                    <Button x:Name="BrowseJavaButton"
                            Content="手动选择..."
                            Padding="12,2"
                            Click="BrowseJava_Click" />
                    <TextBlock x:Name="JavaScanStatusText"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#666666" />
                </StackPanel>

                <TextBlock x:Name="JavaDetailText"
                           Grid.Row="2"
                           Margin="0,6,0,0"
                           Foreground="#666666"
                           TextWrapping="Wrap" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="内存" Margin="0,12,0,0" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CheckBox x:Name="AutoMemoryCheckBox"
                          Content="自动分配内存"
                          Checked="AutoMemory_Changed"
                          Unchecked="AutoMemory_Changed" />

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Slider x:Name="MemorySlider"
                            Minimum="256"
                            Maximum="65536"
                            TickFrequency="128"
                            SmallChange="128"
                            LargeChange="1024"
                            IsSnapToTickEnabled="True"
                            ValueChanged="MemorySlider_ValueChanged" />

                    <TextBlock x:Name="MemoryValueText"
                               Grid.Column="1"
                               Margin="12,0,0,0"
                               MinWidth="90"
                               VerticalAlignment="Center"
                               TextAlignment="Right" />
                </Grid>

                <TextBlock x:Name="MemoryHintText"
                           Grid.Row="2"
                           Margin="0,6,0,0"
                           Foreground="#666666"
                           TextWrapping="Wrap" />
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"
                       Foreground="#666666" />
            <Button Content="取消"
                    Padding="20,4"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="Cancel_Click" />
            <Button x:Name="SaveButton"
                    Content="保存"
                    Padding="20,4"
                    IsDefault="True"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
